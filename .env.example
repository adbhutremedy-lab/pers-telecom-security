# Copy this file to ".env.local" and fill in the three values.
# (On Vercel you type the same three values in Project > Settings > Environment Variables.)
# All three are SAFE for the browser. The Supabase SECRET key (sb_secret_...) is NOT used by this app: never add it here.
# The NAMES must be spelled exactly as below (capital letters, underscores).

# Supabase > Project Settings > API Keys / Data API. Only the bare address, nothing after .co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the PUBLISHABLE key, starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Mapbox > Account > Access tokens: a PUBLIC token, starts with pk.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx

# ---- OPTIONAL (Phase 3): alerts that wake a locked / closed phone ----
# Made with the helper card on the Demo Controller page. Skip this block if you do not use it.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_WEBHOOK_SECRET=
