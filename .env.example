# Copy this file to ".env.local" and fill in the three values.
# (On Vercel you type the same three values in Project > Settings > Environment Variables.)
# All three are SAFE for the browser. The Supabase SECRET key (sb_secret_...) is NOT used by this app: never add it here.

# Supabase > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the PUBLISHABLE key, starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Mapbox > Account > Access tokens: a PUBLIC token, starts with pk.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxx
